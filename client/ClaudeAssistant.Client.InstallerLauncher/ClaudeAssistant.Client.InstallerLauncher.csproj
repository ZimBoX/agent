<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Install ClaudeAssistant</AssemblyName>
    <!-- Тонкий установщик: self-contained single-file с обрезкой (trimming) —
         скачивает Setup.exe с сервера, сам payload не несёт. Trimming ужимает
         сборку (простой загрузчик почти не тянет BCL). Native AOT дал бы ещё
         меньше, но требует настроенного окружения MSVC-линковщика, которого нет
         на сборочной машине (vswhere/link.exe вне PATH) — trimming надёжнее. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Манифест встраивается штатным MSBuild-механизмом при сборке — не
         пост-обработкой готового exe инструментом вроде mt.exe. Патчинг
         УЖЕ собранного Velopack Setup.exe таким инструментом (через
         -outputresource) на практике обрезает его: полезная нагрузка
         Velopack дописана в конец PE-файла отдельным блоком, а запись
         ресурса через стандартный Windows Resource API это не
         сохраняет — известное ограничение API, не наша недоработка.
         Поэтому вместо патчинга чужого бинарника — отдельный маленький
         лаунчер с собственным манифестом, собранный с нуля. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

</Project>
