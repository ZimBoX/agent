<Window
    x:Class="ClaudeAssistant.Client.ChatWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ClaudeAssistant.Client"
    xmlns:services="using:ClaudeAssistant.Client.Services"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls">

    <Grid Background="White" RequestedTheme="Light">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Сайдбар: новый чат + список диалогов -->
        <Grid Grid.Column="0" Background="{StaticResource AppCardBackgroundBrush}" Padding="16" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Чат" FontSize="15" FontWeight="SemiBold"
                       Foreground="{StaticResource AppTextPrimaryBrush}" />

            <Button Grid.Row="1" x:Name="NewChatButton" Content="+ Новый чат" Click="OnNewChatClick"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Background="{StaticResource AppAccentBrush}" Foreground="White" FontWeight="SemiBold"
                    CornerRadius="10" Padding="0,9" BorderThickness="0" />

            <ListView Grid.Row="2" x:Name="ConversationsList" SelectionChanged="OnConversationSelectionChanged"
                      Background="Transparent" BorderThickness="0" Padding="0">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="services:ChatConversationInfo">
                        <TextBlock Text="{x:Bind Title}" FontSize="13" Margin="0,6"
                                   Foreground="{StaticResource AppTextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- Основная область: тред + ввод -->
        <Grid Grid.Column="1" Padding="24" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0" x:Name="ThreadScroll" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ThreadList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:ChatMessage">
                            <Grid Margin="0,0,0,14">
                                <!-- Ответ модели -->
                                <Border Visibility="{x:Bind AssistantVisibility}" HorizontalAlignment="Stretch"
                                        Background="{StaticResource ChatAssistantBrush}" BorderBrush="{StaticResource ChatAssistantBorderBrush}"
                                        BorderThickness="1" CornerRadius="14" Padding="18,14">
                                    <controls:MarkdownTextBlock Text="{x:Bind Text}"
                                                                 Foreground="{StaticResource AppTextPrimaryBrush}"
                                                                 FontSize="14" TextWrapping="Wrap"
                                                                 Header1FontSize="20" Header2FontSize="17" Header3FontSize="15"
                                                                 LinkForeground="{StaticResource AppAccentBrush}" />
                                </Border>
                                <!-- Стриминг ответа: карточка ассистента с индикатором и живым текстом -->
                                <Border Visibility="{x:Bind PendingVisibility}" HorizontalAlignment="Stretch"
                                        Background="{StaticResource ChatAssistantBrush}" BorderBrush="{StaticResource ChatAssistantBorderBrush}"
                                        BorderThickness="1" CornerRadius="14" Padding="18,14">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <ProgressRing IsActive="True" Width="16" Height="16" VerticalAlignment="Top"
                                                      Foreground="{StaticResource AppAccentBrush}" />
                                        <TextBlock Text="{x:Bind Text, Mode=OneWay}" VerticalAlignment="Center"
                                                   Foreground="{StaticResource AppTextPrimaryBrush}" FontSize="14" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <!-- Сообщение пользователя -->
                                <Border Visibility="{x:Bind UserVisibility}" HorizontalAlignment="Right" MaxWidth="560"
                                        Background="{StaticResource ChatUserBrush}" BorderBrush="{StaticResource ChatUserBorderBrush}"
                                        BorderThickness="1" CornerRadius="14" Padding="16,11">
                                    <TextBlock Text="{x:Bind Text}" TextWrapping="Wrap"
                                               Foreground="{StaticResource AppTextPrimaryBrush}" FontSize="14" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Grid Grid.Row="1" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="InputBox" Grid.Column="0" PlaceholderText="Сообщение… (Enter — отправить)"
                         AcceptsReturn="False" TextWrapping="Wrap" KeyDown="OnInputKeyDown"
                         Background="{StaticResource AppCardBackgroundBrush}" BorderBrush="{StaticResource AppBorderBrush}"
                         BorderThickness="1" CornerRadius="10" />
                <Button x:Name="SendButton" Grid.Column="1" Click="OnSendClick"
                        Background="{StaticResource AppAccentBrush}" Foreground="White" FontWeight="SemiBold"
                        CornerRadius="10" Padding="16,0" Content="Отправить" />
            </Grid>
        </Grid>
    </Grid>
</Window>
