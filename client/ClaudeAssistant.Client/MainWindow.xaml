<Window
    x:Class="ClaudeAssistant.Client.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ClaudeAssistant.Client"
    xmlns:services="using:ClaudeAssistant.Client.Services"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls">

    <Grid x:Name="RootGrid" Background="White" RequestedTheme="Light">

        <!-- Компактный вид — набор запроса: шаблон, файлы, "Выполнить".
             Результат сюда не выводится — по выполнении окно переходит в
             расширенный вид (см. ExpandedRoot). Обёрнут в ScrollViewer — при
             фиксированном размере окна длинные статусы генерации ("Всё ещё
             обрабатываем...") иначе обрезались за нижней границей окна и были
             нечитаемы; теперь в таком случае просто появляется прокрутка. -->
        <ScrollViewer x:Name="CompactRoot" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Padding="20" RowSpacing="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Шапка: лого + имя/должность + иконка истории (кнопка выхода — внизу, см. LogoutButton) -->
            <Grid Grid.Row="0" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0" Source="ms-appx:///Assets/logo.svg" Width="34" Height="34" VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="UserNameText" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource AppTextPrimaryBrush}" />
                    <TextBlock x:Name="UserRoleText" FontSize="12" Foreground="{StaticResource AppTextSecondaryBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2">
                    <Button x:Name="ChatButton" Click="OnChatClick" Background="Transparent" BorderThickness="0" Padding="6" CornerRadius="8"
                            ToolTipService.ToolTip="Чат">
                        <!-- Пузырёк-облачко чата -->
                        <Path Data="M 3,3 H 15 A 2,2 0 0 1 17,5 V 11 A 2,2 0 0 1 15,13 H 8 L 4,16 V 13 A 2,2 0 0 1 2,11 V 5 A 2,2 0 0 1 3,3 Z"
                              Stroke="{StaticResource AppTextSecondaryBrush}" StrokeThickness="1.4"
                              StrokeLineJoin="Round" Width="18" Height="18" Stretch="Uniform" />
                    </Button>
                    <Button x:Name="HistoryButton" Click="OnHistoryClick" Background="Transparent" BorderThickness="0" Padding="6" CornerRadius="8"
                            ToolTipService.ToolTip="История">
                        <Grid Width="18" Height="18">
                            <Ellipse Stroke="{StaticResource AppTextSecondaryBrush}" StrokeThickness="1.4" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Line X1="9" Y1="9" X2="9" Y2="4.5" Stroke="{StaticResource AppTextSecondaryBrush}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <Line X1="9" Y1="9" X2="11.8" Y2="11" Stroke="{StaticResource AppTextSecondaryBrush}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Grid>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Шаблон -->
            <StackPanel Grid.Row="1" Spacing="6">
                <TextBlock Text="Шаблон" FontSize="12" Foreground="{StaticResource AppTextSecondaryBrush}" />
                <ComboBox x:Name="TemplateCombo" DisplayMemberPath="Title" HorizontalAlignment="Stretch"
                          SelectionChanged="OnTemplateSelectionChanged"
                          Background="{StaticResource AppCardBackgroundBrush}" BorderBrush="{StaticResource AppBorderBrush}"
                          BorderThickness="1" CornerRadius="10" PlaceholderText="Список..." />
                <TextBox x:Name="CustomPromptBox" Visibility="Collapsed"
                         PlaceholderText="Опишите своими словами, что нужно сделать с документом(ами)..."
                         AcceptsReturn="True" TextWrapping="Wrap" Height="90"
                         Background="{StaticResource AppCardBackgroundBrush}" BorderBrush="{StaticResource AppBorderBrush}"
                         BorderThickness="1" CornerRadius="10" />
                <StackPanel x:Name="ObjectPanel" Visibility="Collapsed" Spacing="6">
                    <TextBlock Text="Объект (для поиска по папке)" FontSize="12" Foreground="{StaticResource AppTextSecondaryBrush}" />
                    <Border Background="{StaticResource AppCardBackgroundBrush}" BorderBrush="{StaticResource AppBorderBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="10,8">
                        <TextBlock x:Name="ObjectRootText" FontSize="13" TextWrapping="Wrap" Foreground="{StaticResource AppTextPrimaryBrush}" />
                    </Border>
                </StackPanel>
                <!-- Селектор модели — виден только админу (тест цена/качество);
                     применяется к своему промпту и к новым чатам -->
                <StackPanel x:Name="ModelPanel" Visibility="Collapsed" Spacing="6">
                    <TextBlock Text="Модель (тест)" FontSize="12" Foreground="{StaticResource AppTextSecondaryBrush}" />
                    <ComboBox x:Name="ModelSelector" DisplayMemberPath="DisplayName" HorizontalAlignment="Stretch"
                              SelectionChanged="OnModelSelectionChanged"
                              Background="{StaticResource AppCardBackgroundBrush}" BorderBrush="{StaticResource AppBorderBrush}"
                              BorderThickness="1" CornerRadius="10" PlaceholderText="По умолчанию" />
                </StackPanel>
            </StackPanel>

            <!-- Файлы: кнопки — растянуты на всю ширину поровну, чтобы совпадать
                 по краям с шаблоном/списком файлов/кнопкой "Выполнить" сверху и
                 снизу, а не оставлять пустой хвост справа -->
            <Grid Grid.Row="2" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" x:Name="AddFilesButton" Content="Добавить файлы..." Click="OnAddFilesClick"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Background="{StaticResource AppCardBackgroundBrush}" BorderBrush="{StaticResource AppBorderBrush}"
                        BorderThickness="1" CornerRadius="10" />
                <Button Grid.Column="1" x:Name="RemoveFilesButton" Content="Убрать выделенное" Click="OnRemoveFilesClick"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Background="{StaticResource AppCardBackgroundBrush}" BorderBrush="{StaticResource AppBorderBrush}"
                        BorderThickness="1" CornerRadius="10" />
            </Grid>

            <!-- Файлы: список. Раньше строка была "*" (тянулась на весь остаток
                 окна) — теперь строки Grid все Auto (весь компактный вид внутри
                 ScrollViewer, см. выше), поэтому высота списка зафиксирована явно,
                 иначе он растягивался бы по числу файлов без предела. -->
            <Border Grid.Row="3" Height="220" Background="{StaticResource AppCardBackgroundBrush}" BorderBrush="{StaticResource AppBorderBrush}"
                    BorderThickness="1" CornerRadius="10">
                <ListView x:Name="FilesList" SelectionMode="Multiple" SelectionChanged="OnFilesSelectionChanged"
                          Background="Transparent" BorderThickness="0" Padding="4" />
            </Border>

            <!-- Выполнить -->
            <StackPanel Grid.Row="4" Spacing="8">
                <Button x:Name="ExecuteButton" Content="Выполнить" Click="OnExecuteClick"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Background="{StaticResource AppAccentBrush}" Foreground="White" FontWeight="SemiBold"
                        CornerRadius="10" Padding="0,11" BorderThickness="0" />
                <!-- Подменяет «Выполнить» на время обработки — прерывает запрос -->
                <Button x:Name="ExecuteStopButton" Content="Прервать" Click="OnExecuteStopClick" Visibility="Collapsed"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Background="#D64545" Foreground="White" FontWeight="SemiBold"
                        CornerRadius="10" Padding="0,11" BorderThickness="0" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ProgressRing x:Name="BusyIndicator" IsActive="False" Width="16" Height="16" />
                    <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource AppTextSecondaryBrush}" />
                </StackPanel>
            </StackPanel>

            <!-- Выход — внизу окна, отдельно от истории в шапке -->
            <Button Grid.Row="5" x:Name="LogoutButton" Click="OnLogoutClick" HorizontalAlignment="Left"
                    Background="Transparent" BorderThickness="0" Padding="6" CornerRadius="8">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Grid Width="18" Height="18">
                        <Ellipse Stroke="{StaticResource AppTextSecondaryBrush}" StrokeThickness="1.4" Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Center" />
                        <Path Data="M 11,9 L 17,9 M 14.3,6.3 L 17,9 L 14.3,11.7" Stroke="{StaticResource AppTextSecondaryBrush}" StrokeThickness="1.4" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Grid>
                    <TextBlock Text="Выйти" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource AppTextSecondaryBrush}" />
                </StackPanel>
            </Button>
        </Grid>
        </ScrollViewer>

        <!-- Расширенный вид — сайдбар с историей (чат-стиль) слева, ответ справа.
             Открывается по клику на историю или после выполнения запроса. -->
        <Grid x:Name="ExpandedRoot" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Background="{StaticResource AppCardBackgroundBrush}" Padding="20" RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Image Grid.Column="0" Source="ms-appx:///Assets/logo.svg" Width="28" Height="28" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="UserNameTextExpanded" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource AppTextPrimaryBrush}" />
                        <TextBlock x:Name="UserRoleTextExpanded" FontSize="11" Foreground="{StaticResource AppTextSecondaryBrush}" />
                    </StackPanel>
                    <Button Grid.Column="2" x:Name="CollapseButton" Click="OnCollapseClick" Background="Transparent" BorderThickness="0" Padding="4" CornerRadius="8"
                            ToolTipService.ToolTip="Назад к новому запросу">
                        <Path Data="M 11,4 L 5,9 L 11,14" Stroke="{StaticResource AppTextSecondaryBrush}" StrokeThickness="1.5"
                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="14" Height="14" Stretch="Uniform" />
                    </Button>
                </Grid>

                <!-- Секция чата -->
                <Button Grid.Row="1" x:Name="ChatNewButton" Content="+ Новый чат" Click="OnNewChatClick"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Background="{StaticResource AppAccentBrush}" Foreground="White" FontWeight="SemiBold"
                        CornerRadius="10" Padding="0,8" BorderThickness="0" />
                <ListView Grid.Row="3" x:Name="ChatConversationsList" SelectionChanged="OnChatConversationSelectionChanged"
                          Background="Transparent" BorderThickness="0" Padding="0">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="services:ChatConversationInfo">
                            <Grid ColumnSpacing="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{x:Bind Title}" FontSize="13" Margin="0,6" VerticalAlignment="Center"
                                           Foreground="{StaticResource AppTextPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                <Button Grid.Column="1" Click="OnDeleteChatClick" Content="✕" FontSize="11" VerticalAlignment="Center"
                                        Background="Transparent" BorderThickness="0" Padding="6,2" CornerRadius="6"
                                        Foreground="{StaticResource AppTextSecondaryBrush}" ToolTipService.ToolTip="Удалить чат" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Секция истории запросов -->
                <TextBlock Grid.Row="4" Text="История" FontSize="12" Foreground="{StaticResource AppTextSecondaryBrush}" />

                <ListView Grid.Row="5" x:Name="HistoryList" SelectionChanged="OnHistorySelectionChanged"
                          Background="Transparent" BorderThickness="0" Padding="0">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:HistoryListItem">
                            <Grid ColumnSpacing="4" Margin="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="1">
                                    <TextBlock Text="{x:Bind Title}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource AppTextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Subtitle}" FontSize="11" Foreground="{StaticResource AppTextSecondaryBrush}" />
                                </StackPanel>
                                <Button Grid.Column="1" Click="OnDeleteHistoryClick" Content="✕" FontSize="11" VerticalAlignment="Center"
                                        Background="Transparent" BorderThickness="0" Padding="6,2" CornerRadius="6"
                                        Foreground="{StaticResource AppTextSecondaryBrush}" ToolTipService.ToolTip="Удалить из истории" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <Button Grid.Row="6" x:Name="LogoutButtonExpanded" Click="OnLogoutClick" HorizontalAlignment="Left"
                        Background="Transparent" BorderThickness="0" Padding="6" CornerRadius="8">
                    <Grid Width="18" Height="18">
                        <Ellipse Stroke="{StaticResource AppTextSecondaryBrush}" StrokeThickness="1.4" Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Center" />
                        <Path Data="M 11,9 L 17,9 M 14.3,6.3 L 17,9 L 14.3,11.7" Stroke="{StaticResource AppTextSecondaryBrush}" StrokeThickness="1.4" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Grid>
                </Button>
            </Grid>

            <Grid Grid.Column="1" Padding="30" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" x:Name="ResultActionsPanel" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                    <Button x:Name="CopyButton" Content="Копировать" Click="OnCopyClick"
                            Background="{StaticResource AppCardBackgroundBrush}" BorderBrush="{StaticResource AppBorderBrush}"
                            BorderThickness="1" CornerRadius="10" />
                    <Button x:Name="SaveButton" Content="Сохранить..." Click="OnSaveClick"
                            Background="{StaticResource AppCardBackgroundBrush}" BorderBrush="{StaticResource AppBorderBrush}"
                            BorderThickness="1" CornerRadius="10" />
                </StackPanel>

                <!-- Тред диалога: ответы и follow-up-вопросы копятся лентой сверху вниз.
                     Первый элемент — ответ на исходный запрос; дальше пары вопрос/ответ. -->
                <ScrollViewer Grid.Row="1" x:Name="ThreadScroll" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ThreadList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:ChatMessage">
                                <Grid Margin="0,0,0,14">
                                    <!-- Ответ модели: широкая мягкая карточка слева -->
                                    <Border Visibility="{x:Bind AssistantVisibility}" HorizontalAlignment="Stretch"
                                            Background="{StaticResource ChatAssistantBrush}" BorderBrush="{StaticResource ChatAssistantBorderBrush}"
                                            BorderThickness="1" CornerRadius="14" Padding="18,14">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="Claude Assistant" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{StaticResource AppTextSecondaryBrush}" />
                                            <controls:MarkdownTextBlock Text="{x:Bind Text}"
                                                                         Foreground="{StaticResource AppTextPrimaryBrush}"
                                                                         FontSize="14" TextWrapping="Wrap"
                                                                         Header1FontSize="20" Header2FontSize="17" Header3FontSize="15"
                                                                         LinkForeground="{StaticResource AppAccentBrush}" />
                                            <!-- Файлы, созданные моделью (create_file): кнопки скачивания -->
                                            <ItemsControl ItemsSource="{x:Bind Files}" Visibility="{x:Bind FilesVisibility}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="services:GeneratedFile">
                                                        <Button Click="OnDownloadFileClick" IsEnabled="{x:Bind Available}" Margin="0,4,0,0" HorizontalAlignment="Left"
                                                                Background="{StaticResource AppCardBackgroundBrush}" BorderBrush="{StaticResource AppBorderBrush}"
                                                                BorderThickness="1" CornerRadius="10" Padding="12,8"
                                                                ToolTipService.ToolTip="Скачать файл">
                                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                                <Path Data="M12 3v12m0 0l-4-4m4 4l4-4M4 19h16"
                                                                      Stroke="{StaticResource AppAccentBrush}" StrokeThickness="2" StrokeLineJoin="Round"
                                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="16" Height="16" Stretch="Uniform" />
                                                                <TextBlock Text="{x:Bind Label}" VerticalAlignment="Center" FontSize="13"
                                                                           FontWeight="SemiBold" Foreground="{StaticResource AppTextPrimaryBrush}" />
                                                            </StackPanel>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                    <!-- Обработка запроса: карточка ассистента с индикатором и живым
                                         статусом ("Думаю…", "Читаю: договор.pdf"); заменяется ответом
                                         по готовности (см. MainWindow.AddPendingBubble). -->
                                    <Border Visibility="{x:Bind PendingVisibility}" HorizontalAlignment="Stretch"
                                            Background="{StaticResource ChatAssistantBrush}" BorderBrush="{StaticResource ChatAssistantBorderBrush}"
                                            BorderThickness="1" CornerRadius="14" Padding="18,14">
                                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                            <ProgressRing IsActive="True" Width="18" Height="18" Foreground="{StaticResource AppAccentBrush}" />
                                            <TextBlock Text="{x:Bind Text, Mode=OneWay}" VerticalAlignment="Center"
                                                       Foreground="{StaticResource AppTextSecondaryBrush}" FontSize="14" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                    <!-- Вопрос пользователя: компактный акцентный пузырь справа -->
                                    <Border Visibility="{x:Bind UserVisibility}" HorizontalAlignment="Right" MaxWidth="560"
                                            Background="{StaticResource ChatUserBrush}" BorderBrush="{StaticResource ChatUserBorderBrush}"
                                            BorderThickness="1" CornerRadius="14" Padding="16,11">
                                        <TextBlock Text="{x:Bind Text}" TextWrapping="Wrap"
                                                   Foreground="{StaticResource AppTextPrimaryBrush}" FontSize="14" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Поле продолжения диалога. Видно, пока сессия активна (есть
                     conversationId и не истекла) — см. MainWindow.SetFollowUpAvailable. -->
                <StackPanel Grid.Row="2" Spacing="6">
                    <TextBlock x:Name="FollowUpAttachmentsText" Visibility="Collapsed" FontSize="12" TextWrapping="Wrap"
                               Foreground="{StaticResource AppTextSecondaryBrush}" Tapped="OnClearFollowUpAttachments"
                               ToolTipService.ToolTip="Нажмите, чтобы убрать прикреплённые файлы" />
                    <Grid x:Name="FollowUpPanel" ColumnSpacing="8" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="FollowUpAttachButton" Grid.Column="0" Click="OnFollowUpAttachClick" Height="38" Width="42"
                                ToolTipService.ToolTip="Прикрепить файлы (.docx, .xlsx, .pdf)"
                                Background="{StaticResource AppCardBackgroundBrush}" BorderBrush="{StaticResource AppBorderBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="0">
                            <Path Data="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"
                                  Stroke="{StaticResource AppTextSecondaryBrush}" StrokeThickness="2" StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="17" Height="17" Stretch="Uniform" />
                        </Button>
                        <TextBox x:Name="FollowUpBox" Grid.Column="1" Height="38" VerticalContentAlignment="Center"
                                 PlaceholderText="Продолжить диалог... (Enter — отправить)"
                                 AcceptsReturn="False" TextWrapping="Wrap" KeyDown="OnFollowUpKeyDown"
                                 Background="{StaticResource AppCardBackgroundBrush}" BorderBrush="{StaticResource AppBorderBrush}"
                                 BorderThickness="1" CornerRadius="10" />
                        <Button x:Name="FollowUpSend" Grid.Column="2" Click="OnFollowUpSendClick" Height="38"
                                Background="{StaticResource AppAccentBrush}" Foreground="White" FontWeight="SemiBold"
                                CornerRadius="10" Padding="16,0" Content="Отправить" />
                        <Button x:Name="FollowUpStop" Grid.Column="2" Click="OnFollowUpStopClick" Height="38" Visibility="Collapsed"
                                Background="#D64545" Foreground="White" FontWeight="SemiBold"
                                CornerRadius="10" Padding="16,0" Content="Прервать" />
                    </Grid>
                    <TextBlock x:Name="FollowUpHint" Visibility="Collapsed" FontSize="12"
                               Foreground="{StaticResource AppTextSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>

                <!-- Поле ввода в режиме чата (скрыто в режиме истории; см. EnterChatMode/EnterHistoryMode) -->
                <StackPanel Grid.Row="2" x:Name="ChatInputPanel" Spacing="6" Visibility="Collapsed">
                    <TextBlock x:Name="ChatAttachmentsText" Visibility="Collapsed" FontSize="12" TextWrapping="Wrap"
                               Foreground="{StaticResource AppTextSecondaryBrush}" Tapped="OnClearChatAttachments"
                               ToolTipService.ToolTip="Нажмите, чтобы убрать прикреплённые файлы" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="ChatAttachButton" Grid.Column="0" Click="OnChatAttachClick" Height="38" Width="42"
                                ToolTipService.ToolTip="Прикрепить файлы (.docx, .xlsx, .pdf)"
                                Background="{StaticResource AppCardBackgroundBrush}" BorderBrush="{StaticResource AppBorderBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="0">
                            <Path Data="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"
                                  Stroke="{StaticResource AppTextSecondaryBrush}" StrokeThickness="2" StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="17" Height="17" Stretch="Uniform" />
                        </Button>
                        <TextBox x:Name="ChatInputBox" Grid.Column="1" Height="38" VerticalContentAlignment="Center"
                                 PlaceholderText="Сообщение… (Enter — отправить)"
                                 AcceptsReturn="False" TextWrapping="Wrap" KeyDown="OnChatInputKeyDown"
                                 Background="{StaticResource AppCardBackgroundBrush}" BorderBrush="{StaticResource AppBorderBrush}"
                                 BorderThickness="1" CornerRadius="10" />
                        <Button x:Name="ChatSendButton" Grid.Column="2" Click="OnChatSendClick" Height="38"
                                Background="{StaticResource AppAccentBrush}" Foreground="White" FontWeight="SemiBold"
                                CornerRadius="10" Padding="16,0" Content="Отправить" />
                        <Button x:Name="ChatStopButton" Grid.Column="2" Click="OnChatStopClick" Height="38" Visibility="Collapsed"
                                Background="#D64545" Foreground="White" FontWeight="SemiBold"
                                CornerRadius="10" Padding="16,0" Content="Прервать" />
                    </Grid>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
