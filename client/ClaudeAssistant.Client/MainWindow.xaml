<Window
    x:Class="ClaudeAssistant.Client.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ClaudeAssistant.Client"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls">

    <Grid x:Name="RootGrid" Background="White" RequestedTheme="Light">

        <!-- Компактный вид — набор запроса: шаблон, файлы, "Выполнить".
             Результат сюда не выводится — по выполнении окно переходит в
             расширенный вид (см. ExpandedRoot). -->
        <Grid x:Name="CompactRoot" Padding="20" RowSpacing="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Шапка: лого + имя/должность + иконки истории и выхода -->
            <Grid Grid.Row="0" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0" Source="ms-appx:///Assets/logo.svg" Width="34" Height="34" VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="UserNameText" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource AppTextPrimaryBrush}" />
                    <TextBlock x:Name="UserRoleText" FontSize="12" Foreground="{StaticResource AppTextSecondaryBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                    <Button x:Name="HistoryButton" Click="OnHistoryClick" Background="Transparent" BorderThickness="0" Padding="6" CornerRadius="8">
                        <Grid Width="18" Height="18">
                            <Ellipse Stroke="{StaticResource AppTextSecondaryBrush}" StrokeThickness="1.4" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Line X1="9" Y1="9" X2="9" Y2="4.5" Stroke="{StaticResource AppTextSecondaryBrush}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <Line X1="9" Y1="9" X2="11.8" Y2="11" Stroke="{StaticResource AppTextSecondaryBrush}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Grid>
                    </Button>
                    <Button x:Name="LogoutButton" Click="OnLogoutClick" Background="Transparent" BorderThickness="0" Padding="6" CornerRadius="8">
                        <Grid Width="18" Height="18">
                            <Ellipse Stroke="{StaticResource AppTextSecondaryBrush}" StrokeThickness="1.4" Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Center" />
                            <Path Data="M 11,9 L 17,9 M 14.3,6.3 L 17,9 L 14.3,11.7" Stroke="{StaticResource AppTextSecondaryBrush}" StrokeThickness="1.4" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Grid>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Шаблон -->
            <StackPanel Grid.Row="1" Spacing="6">
                <TextBlock Text="Шаблон" FontSize="12" Foreground="{StaticResource AppTextSecondaryBrush}" />
                <ComboBox x:Name="TemplateCombo" DisplayMemberPath="Title" HorizontalAlignment="Stretch"
                          SelectionChanged="OnTemplateSelectionChanged"
                          Background="{StaticResource AppCardBackgroundBrush}" BorderBrush="{StaticResource AppBorderBrush}"
                          BorderThickness="1" CornerRadius="10" PlaceholderText="Список..." />
                <TextBox x:Name="CustomPromptBox" Visibility="Collapsed"
                         PlaceholderText="Опишите своими словами, что нужно сделать с документом(ами)..."
                         AcceptsReturn="True" TextWrapping="Wrap" Height="90"
                         Background="{StaticResource AppCardBackgroundBrush}" BorderBrush="{StaticResource AppBorderBrush}"
                         BorderThickness="1" CornerRadius="10" />
                <StackPanel x:Name="ObjectPanel" Visibility="Collapsed" Spacing="6">
                    <TextBlock Text="Объект (для поиска по папке)" FontSize="12" Foreground="{StaticResource AppTextSecondaryBrush}" />
                    <Border Background="{StaticResource AppCardBackgroundBrush}" BorderBrush="{StaticResource AppBorderBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="10,8">
                        <TextBlock x:Name="ObjectRootText" FontSize="13" TextWrapping="Wrap" Foreground="{StaticResource AppTextPrimaryBrush}" />
                    </Border>
                </StackPanel>
            </StackPanel>

            <!-- Файлы: кнопки — растянуты на всю ширину поровну, чтобы совпадать
                 по краям с шаблоном/списком файлов/кнопкой "Выполнить" сверху и
                 снизу, а не оставлять пустой хвост справа -->
            <Grid Grid.Row="2" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" x:Name="AddFilesButton" Content="Добавить файлы..." Click="OnAddFilesClick"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Background="{StaticResource AppCardBackgroundBrush}" BorderBrush="{StaticResource AppBorderBrush}"
                        BorderThickness="1" CornerRadius="10" />
                <Button Grid.Column="1" x:Name="RemoveFilesButton" Content="Убрать выделенное" Click="OnRemoveFilesClick"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Background="{StaticResource AppCardBackgroundBrush}" BorderBrush="{StaticResource AppBorderBrush}"
                        BorderThickness="1" CornerRadius="10" />
            </Grid>

            <!-- Файлы: список -->
            <Border Grid.Row="3" Background="{StaticResource AppCardBackgroundBrush}" BorderBrush="{StaticResource AppBorderBrush}"
                    BorderThickness="1" CornerRadius="10">
                <ListView x:Name="FilesList" SelectionMode="Multiple" SelectionChanged="OnFilesSelectionChanged"
                          Background="Transparent" BorderThickness="0" Padding="4" />
            </Border>

            <!-- Выполнить -->
            <StackPanel Grid.Row="4" Spacing="8">
                <Button x:Name="ExecuteButton" Content="Выполнить" Click="OnExecuteClick"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Background="{StaticResource AppAccentBrush}" Foreground="White" FontWeight="SemiBold"
                        CornerRadius="10" Padding="0,11" BorderThickness="0" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ProgressRing x:Name="BusyIndicator" IsActive="False" Width="16" Height="16" />
                    <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource AppTextSecondaryBrush}" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Расширенный вид — сайдбар с историей (чат-стиль) слева, ответ справа.
             Открывается по клику на историю или после выполнения запроса. -->
        <Grid x:Name="ExpandedRoot" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Background="{StaticResource AppCardBackgroundBrush}" Padding="20" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Image Grid.Column="0" Source="ms-appx:///Assets/logo.svg" Width="28" Height="28" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="UserNameTextExpanded" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource AppTextPrimaryBrush}" />
                        <TextBlock x:Name="UserRoleTextExpanded" FontSize="11" Foreground="{StaticResource AppTextSecondaryBrush}" />
                    </StackPanel>
                    <Button Grid.Column="2" x:Name="CollapseButton" Click="OnCollapseClick" Background="Transparent" BorderThickness="0" Padding="4" CornerRadius="8"
                            ToolTipService.ToolTip="Назад к новому запросу">
                        <Path Data="M 11,4 L 5,9 L 11,14" Stroke="{StaticResource AppTextSecondaryBrush}" StrokeThickness="1.5"
                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="14" Height="14" Stretch="Uniform" />
                    </Button>
                </Grid>

                <TextBlock Grid.Row="1" Text="История" FontSize="12" Foreground="{StaticResource AppTextSecondaryBrush}" />

                <ListView Grid.Row="2" x:Name="HistoryList" SelectionChanged="OnHistorySelectionChanged"
                          Background="Transparent" BorderThickness="0" Padding="0">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:HistoryListItem">
                            <StackPanel Margin="0,6" Spacing="1">
                                <TextBlock Text="{x:Bind Title}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource AppTextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind Subtitle}" FontSize="11" Foreground="{StaticResource AppTextSecondaryBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <Button Grid.Row="3" x:Name="LogoutButtonExpanded" Click="OnLogoutClick" HorizontalAlignment="Left"
                        Background="Transparent" BorderThickness="0" Padding="6" CornerRadius="8">
                    <Grid Width="18" Height="18">
                        <Ellipse Stroke="{StaticResource AppTextSecondaryBrush}" StrokeThickness="1.4" Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Center" />
                        <Path Data="M 11,9 L 17,9 M 14.3,6.3 L 17,9 L 14.3,11.7" Stroke="{StaticResource AppTextSecondaryBrush}" StrokeThickness="1.4" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Grid>
                </Button>
            </Grid>

            <Grid Grid.Column="1" Padding="30" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                    <Button x:Name="CopyButton" Content="Копировать" Click="OnCopyClick"
                            Background="{StaticResource AppCardBackgroundBrush}" BorderBrush="{StaticResource AppBorderBrush}"
                            BorderThickness="1" CornerRadius="10" />
                    <Button x:Name="SaveButton" Content="Сохранить..." Click="OnSaveClick"
                            Background="{StaticResource AppCardBackgroundBrush}" BorderBrush="{StaticResource AppBorderBrush}"
                            BorderThickness="1" CornerRadius="10" />
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <controls:MarkdownTextBlock x:Name="ResultBox"
                                                 Foreground="{StaticResource AppTextPrimaryBrush}"
                                                 FontSize="14" TextWrapping="Wrap"
                                                 Header1FontSize="20" Header2FontSize="17" Header3FontSize="15"
                                                 LinkForeground="{StaticResource AppAccentBrush}" />
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
