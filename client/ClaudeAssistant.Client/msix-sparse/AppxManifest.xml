<?xml version="1.0" encoding="utf-8"?>
<!--
  Sparse MSIX-пакет — не сама программа (та ставится и обновляется через
  Velopack, как и раньше), а тонкая "визитка", которую Проводник Windows 11
  соглашается показывать в верхнем уровне контекстного меню (не в "Показать
  больше опций"). Регистрируется поверх уже установленной копии клиента через
  `Add-AppxPackage -Register Package.appxmanifest -ExternalLocation <папка установки>`
  (см. ShellExtensionRegistrar / install-hook в App.xaml.cs) — сама MSIX-упаковка
  не содержит файлов приложения, только манифест + иконки.

  windows.fileExplorerContextMenus ссылается на CLSID обработчика
  (IExplorerCommand, comhost.dll). КЛЮЧЕВОЙ момент, найденный сравнением с
  рабочим sparse-пакетом самого VS Code
  (Microsoft.VisualStudioCode_..._neutral__8wekyb3d8bbwe): для СОВРЕМЕННОГО
  меню Windows 11 этот CLSID должен резолвиться как packaged-COM — через
  <com:Extension Category="windows.comServer"> ВНУТРИ пакета, а не через
  классическую запись HKCU\CLSID\...\InprocServer32 (та работает только для
  старого меню в "Показать дополнительные параметры"). Без com:ComServer
  Windows не может активировать обработчик и молча выкидывает пункт из
  верхнего уровня меню, хотя Get-AppxPackage и показывает Status: Ok.
  VS Code делает именно так — SurrogateServer, ссылающийся на свою DLL.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:desktop4="http://schemas.microsoft.com/appx/manifest/desktop/windows10/4"
  xmlns:desktop5="http://schemas.microsoft.com/appx/manifest/desktop/windows10/5"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  IgnorableNamespaces="uap rescap desktop4 desktop5 uap10 com">

  <Identity
    Name="ClaudeAssistant.ShellExtension"
    Publisher="CN=ClaudeAssistant"
    Version="1.0.0.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Claude Assistant</DisplayName>
    <PublisherDisplayName>ClaudeAssistant</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <!-- Без этого Add-AppxPackage -ExternalLocation отказывает с
         0x80073D2E независимо от прав администратора и sideloading —
         подтверждено прямым запуском на реальной машине (см.
         IMPLEMENTATION_CHECKLIST.md, Этап 11). -->
    <uap10:AllowExternalContent>true</uap10:AllowExternalContent>
  </Properties>

  <Resources>
    <Resource Language="ru-ru" />
  </Resources>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Applications>
    <!-- Executable указывает на реальный exe установленного клиента (папка
         "current" — тот же путь, что и в ShellExtensionRegistrar) — этот
         Application-элемент никогда не запускается напрямую, схема
         sparse-пакета просто требует валидную ссылку. -->
    <Application Id="ClaudeAssistant" Executable="ClaudeAssistant.Client.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Claude Assistant"
        Description="Отправка файлов и папок в Claude Assistant из контекстного меню Проводника"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <desktop4:Extension Category="windows.fileExplorerContextMenus">
          <desktop4:FileExplorerContextMenus>
            <!-- Файлы — desktop4:ItemType допускает только "*" или ".расширение"
                 (см. DesktopManifestSchema_v4.xsd, ST_FileType), не "Directory". -->
            <desktop4:ItemType Type="*">
              <desktop4:Verb Id="ClaudeAssistantSendTo" Clsid="B932951B-8D25-4B01-9CD6-C0AB6801A39E" />
            </desktop4:ItemType>
            <!-- Папки — отдельный элемент desktop5:ItemType (schema v5,
                 ST_FileTypeOrStarWithDirectory) — Type="Directory" не поддерживается
                 в v4, только начиная с v5. -->
            <desktop5:ItemType Type="Directory">
              <desktop5:Verb Id="ClaudeAssistantSendToDirectory" Clsid="B932951B-8D25-4B01-9CD6-C0AB6801A39E" />
            </desktop5:ItemType>
          </desktop4:FileExplorerContextMenus>
        </desktop4:Extension>
        <!-- Packaged-COM объявление того же CLSID — без него современное меню
             Windows 11 не активирует обработчик (см. комментарий вверху файла).
             SurrogateServer хостит нашу in-proc comhost.dll в суррогатном
             процессе (dllhost) — тот же приём, что у VS Code. Path — относительно
             внешнего расположения пакета (-ExternalLocation = папка "current"),
             там DLL лежит в подпапке ShellExtension\. -->
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:SurrogateServer DisplayName="Claude Assistant">
              <com:Class Id="B932951B-8D25-4B01-9CD6-C0AB6801A39E"
                         Path="ShellExtension\ClaudeAssistant.ShellExtension.comhost.dll"
                         ThreadingModel="Both" />
            </com:SurrogateServer>
          </com:ComServer>
        </com:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
