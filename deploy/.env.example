# Скопировать в deploy/.env на сервере и заполнить. В git .env НЕ коммитим.
#
#   cp .env.example .env && nano .env

# Ключ агрегатора aitunnel.ru — без него бэкенд не вызовет модель.
AITUNNEL_API_KEY=sk-aitunnel-...

# Пароль веб-панели админа (/admin). Логин по умолчанию — admin.
# ОБЯЗАТЕЛЬНО смените: сервер доступен всей локальной сети.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Пароль пользователя postgres в контейнере БД. Можно оставить дефолтный для
# закрытой сети, но лучше сменить.
POSTGRES_PASSWORD=devpassword
